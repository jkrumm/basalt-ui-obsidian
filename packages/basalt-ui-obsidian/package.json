    "@types/mdast": "4.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "basalt-ui": "1.13.0",
    "hast-util-sanitize": "5.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "peerDependencies": {
    "@mantine/core": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "basalt-ui": "^1.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
