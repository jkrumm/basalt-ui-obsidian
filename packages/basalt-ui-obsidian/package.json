{
  "name": "basalt-ui-obsidian",
  "version": "0.0.0",
  "description": "Read an Obsidian vault on the web — React components built on basalt-ui.",
  "license": "Apache-2.0",
  "author": "Johannes Krumm",
  "files": [
    "dist/",
    "src/"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationMap",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "obsidian-vault-core": "workspace:*"
  },
  "devDependencies": {
    "@mantine/core": "9.3.2",
    "@mantine/hooks": "9.3.2",
    "@types/bun": "1.3.14",
