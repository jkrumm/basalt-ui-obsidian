{
  "name": "basalt-ui-obsidian-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --ignore-path=.gitignore packages apps *.json *.md",
    "fmt:check": "oxfmt --check --ignore-path=.gitignore packages apps *.json *.md",
    "format": "bun run fmt",
    "lint": "oxlint",
    "lint:basalt": "oxlint . && ./packages/basalt-ui-obsidian/node_modules/.bin/basalt-ui check-theme",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "build": "bun --filter obsidian-vault-core build && bun --filter basalt-ui-obsidian build",
    "pre": "bun run fmt:check && bun run lint:basalt && bun run typecheck && bun run test",
    "dev": "bun --filter @basalt-ui-obsidian/demo dev"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "happy-dom": "21.0.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "basalt": {
    "roots": [
      "packages/basalt-ui-obsidian/src",
      "apps/demo/src"
    ]
  }
}
